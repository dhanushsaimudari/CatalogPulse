# CatalogPulse AI — Environment Configuration Template
# From raw industrial data to verified, commerce-ready catalogs.

# Application Environment & URLs
APP_ENV=development
PORT=8000
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Primary AI Provider: Google Gemini API
PRIMARY_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Fallback AI Provider: IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# AI Session Limits & Budgeting
MAX_AI_REQUESTS_PER_SESSION=500
MAX_AI_TOKENS_PER_SESSION=200000

# Cloud Object Storage Credentials (Optional)
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_API_KEY=your_ibm_cos_api_key
IBM_COS_INSTANCE_ID=your_ibm_cos_instance_crn
IBM_COS_BUCKET=catalogpulse-ai-bucket

# Session Management
SESSION_TIMEOUT_MINUTES=60

